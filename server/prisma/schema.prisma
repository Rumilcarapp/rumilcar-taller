generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ========================
// Workshop & Users
// ========================

model Workshop {
  id              String   @id @default(uuid())
  name            String
  legalName       String?
  taxId           String?
  address         String?
  website         String?
  phone           String?
  email           String?
  logoUrl         String?
  anchorCurrency  String   @default("USD")
  usdtSpread      Float    @default(0)
  autoExchangeRate Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  mechanics       Mechanic[]
  exchangeRates   ExchangeRate[]
  paymentMethods  WorkshopPaymentMethod[]
  clients         Client[]
  workOrders      WorkOrder[]
  inventoryItems  InventoryItem[]
  appointments    Appointment[]
  saldosVES       SaldoVES[]
  antiInflationConversions AntiInflationConversion[]
  alertaDevaluacionConfig  AlertaDevaluacionConfig?
  subscription             Subscription?
  subscriptionPayments     SubscriptionPayment[]
  supportTickets           SupportTicket[]
  cashSessions             CashSession[]
  cashMovements            CashMovement[]
  expenses                 Expense[]
  inventoryMovements       InventoryMovement[]
  mechanicPayrolls         MechanicPayroll[]
  auditLogs                AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  workshopId   String
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OWNER")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop     Workshop @relation(fields: [workshopId], references: [id])
  workOrders   WorkOrder[] @relation("CreatedBy")
}

model Mechanic {
  id           String   @id @default(uuid())
  workshopId   String
  name         String
  photoUrl     String?
  specialty    String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop     Workshop @relation(fields: [workshopId], references: [id])
  assignments  WorkOrderAssignment[]
  appointments Appointment[]
  payrolls     MechanicPayroll[]

  @@index([workshopId])
}

// ========================
// Multi-Currency Engine
// ========================

model ExchangeRate {
  id           String   @id @default(uuid())
  workshopId   String
  currency     String   @default("VES")
  rateToAnchor Float
  source       String   @default("manual")
  effectiveAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  workshop     Workshop @relation(fields: [workshopId], references: [id])

  @@index([workshopId, effectiveAt])
}

model ExchangeRateSnapshot {
  id             String   @id @default(uuid())
  vesRate        Float
  usdtSpread     Float
  anchorCurrency String
  capturedAt     DateTime @default(now())

  payments       Payment[]
}

model WorkshopPaymentMethod {
  id         String  @id @default(uuid())
  workshopId String
  method     String
  isEnabled  Boolean @default(true)

  workshop   Workshop @relation(fields: [workshopId], references: [id])

  @@unique([workshopId, method])
}

model SaldoVES {
  id              String   @id @default(uuid())
  workshopId      String
  montoVES        Float    @default(0)
  valorUSDIngreso Float    @default(0)
  tasaIngreso     Float    @default(0)
  fechaIngreso    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workshop        Workshop @relation(fields: [workshopId], references: [id])
}

model AntiInflationConversion {
  id                      String   @id @default(uuid())
  workshopId              String
  fecha                   DateTime @default(now())
  montoVES                Float
  tasaUsada               Float
  usdtBruto               Float
  comisionPorcentaje      Float    @default(0)
  usdtNeto                Float
  plataforma              String   @default("binance_p2p")
  plataformaPersonalizada String?
  notas                   String?
  createdAt               DateTime @default(now())

  workshop                Workshop @relation(fields: [workshopId], references: [id])
}

model AlertaDevaluacionConfig {
  id                     String   @id @default(uuid())
  workshopId             String   @unique
  umbralPorcentaje       Float    @default(3)
  umbralDias             Int      @default(3)
  proyeccionSubidaDiaria Float    @default(0.5)
  canalNotificacion      String   @default("inapp")
  activa                 Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  workshop               Workshop @relation(fields: [workshopId], references: [id])
}

// ========================
// Clients & Vehicles
// ========================

model Client {
  id         String   @id @default(uuid())
  workshopId String
  name       String
  email      String?
  phone      String?
  taxId      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workshop   Workshop  @relation(fields: [workshopId], references: [id])
  vehicles   Vehicle[]
  workOrders WorkOrder[]
  appointments Appointment[]

  @@index([workshopId])
}

model Vehicle {
  id           String   @id @default(uuid())
  clientId     String
  make         String
  model        String
  year         Int?
  licensePlate String?
  vin          String?
  color        String?
  mileage      Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client       Client     @relation(fields: [clientId], references: [id])
  workOrders   WorkOrder[]
  appointments Appointment[]

  @@index([clientId])
}

// ========================
// Work Orders & Payments
// ========================

model WorkOrder {
  id          String   @id @default(uuid())
  workshopId  String
  clientId    String
  vehicleId   String
  createdById String
  orderNumber Int
  status      String   @default("RECEIVED")
  totalAnchor Float    @default(0)
  notes       String?
  inspectionNotes String?
  receivedAt  DateTime @default(now())
  completedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop           Workshop            @relation(fields: [workshopId], references: [id])
  client             Client              @relation(fields: [clientId], references: [id])
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id])
  createdBy          User                @relation("CreatedBy", fields: [createdById], references: [id])

  items              WorkOrderItem[]
  photos             WorkOrderPhoto[]
  payments           Payment[]
  assignments        WorkOrderAssignment[]
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]

  @@unique([workshopId, orderNumber])
  @@index([workshopId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
}

model WorkOrderPhoto {
  id          String   @id @default(uuid())
  workOrderId String
  photoUrl    String
  notes       String?
  createdAt   DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
}

model WorkOrderItem {
  id              String  @id @default(uuid())
  workOrderId     String
  type            String  @default("SERVICE")
  description     String
  quantity        Float   @default(1)
  unitPriceAnchor Float
  inventoryItemId String?

  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

model WorkOrderAssignment {
  id           String    @id @default(uuid())
  workOrderId  String
  mechanicId   String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id])
  mechanic     Mechanic  @relation(fields: [mechanicId], references: [id])
}

model Payment {
  id                     String   @id @default(uuid())
  workOrderId            String?
  amount                 Float
  currency               String
  paymentMethod          String
  exchangeRateSnapshotId String
  reference              String?
  notes                  String?
  paidAt                 DateTime @default(now())

  workOrder              WorkOrder?           @relation(fields: [workOrderId], references: [id])
  exchangeRateSnapshot   ExchangeRateSnapshot @relation(fields: [exchangeRateSnapshotId], references: [id])
}

// ========================
// Inventory
// ========================

model InventoryItem {
  id              String   @id @default(uuid())
  workshopId      String
  sku             String?
  name            String
  description     String?
  category        String?
  unitPriceAnchor Float
  costPriceAnchor Float?
  currentStock    Float    @default(0)
  minStock        Float    @default(0)
  unit            String   @default("unidad")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workshop        Workshop            @relation(fields: [workshopId], references: [id])
  workOrderItems  WorkOrderItem[]
  movements       InventoryMovement[]

  @@unique([workshopId, sku])
  @@index([workshopId])
}

// ========================
// Appointments (Agenda)
// ========================

model Appointment {
  id           String   @id @default(uuid())
  workshopId   String
  clientId     String
  vehicleId    String
  mechanicId   String?
  startAt      DateTime
  endAt        DateTime
  modality     String   @default("TALLER")
  serviceMotif String
  internalNotes String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop     Workshop @relation(fields: [workshopId], references: [id])
  client       Client   @relation(fields: [clientId], references: [id])
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  mechanic     Mechanic? @relation(fields: [mechanicId], references: [id])
}

// ========================
// SaaS Memberships & Subscriptions
// ========================

model Subscription {
  id                 String   @id @default(uuid())
  workshopId         String   @unique
  plan               String   @default("TRIAL") // TRIAL, BASIC, PRO, ELITE
  status             String   @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, SUSPENDED, CANCELED
  trialStartedAt     DateTime @default(now())
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  billingCycle       String   @default("MONTHLY") // MONTHLY, YEARLY
  priceUSD           Float    @default(0)
  maxMechanics       Int      @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workshop           Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  payments           SubscriptionPayment[]
}

model SubscriptionPayment {
  id              String   @id @default(uuid())
  subscriptionId  String
  workshopId      String
  amountUSD       Float
  amountVES       Float?
  paymentMethod   String   // PAGO_MOVIL, ZINLI, USDT_BINANCE
  referenceNumber String
  receiptUrl      String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes           String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workshop        Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
}

model SaaSAnnouncement {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("INFO") // INFO, UPDATE, WARNING, PROMO
  targetPlan  String   @default("ALL")  // ALL, TRIAL, BASIC, PRO, ELITE
  isActive    Boolean  @default(true)
  createdBy   String   @default("SuperAdmin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id              String   @id @default(uuid())
  workshopId      String
  subject         String
  description     String
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workshop        Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
}

// ==========================================
// Venezuelan Workshop Cash & Financial Engine
// ==========================================

model CashSession {
  id             String         @id @default(uuid())
  workshopId     String
  openedById     String
  openedByName   String?
  openedAt       DateTime       @default(now())
  closedById     String?
  closedByName   String?
  closedAt       DateTime?
  initialUSD     Float          @default(0)
  initialVES     Float          @default(0)
  expectedUSD    Float          @default(0)
  expectedVES    Float          @default(0)
  actualUSD      Float?
  actualVES      Float?
  differenceUSD  Float?
  differenceVES  Float?
  status         String         @default("OPEN") // OPEN, CLOSED
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workshop       Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  movements      CashMovement[]

  @@index([workshopId, status])
}

model CashMovement {
  id               String        @id @default(uuid())
  workshopId       String
  sessionId        String?
  type             String        // INCOME, EXPENSE
  category         String        // WORK_ORDER, SPARE_PART, PETTY_CASH, UTILITIES, SALARY, OWNER_WITHDRAWAL, OTHER
  description      String
  amountUSD        Float
  amountVES        Float         @default(0)
  exchangeRate     Float         @default(0)
  paymentMethod    String        // CASH_USD, CASH_VES, PAGO_MOVIL, BANK_TRANSFER, ZELLE, USDT_WALLET, POS_DEBIT
  reference        String?
  workOrderId      String?
  expenseId        String?
  registeredById   String?
  registeredByName String?
  createdAt        DateTime      @default(now())

  workshop         Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  session          CashSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  workOrder        WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  expense          Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([workshopId, createdAt])
  @@index([sessionId])
}

model Expense {
  id             String         @id @default(uuid())
  workshopId     String
  category       String         // REPUESTOS, SERVICIOS, NOMINA, ALQUILER, HERRAMIENTAS, OTROS
  description    String
  amountUSD      Float
  amountVES      Float          @default(0)
  exchangeRate   Float          @default(0)
  paymentMethod  String
  reference      String?
  supplierName   String?
  supplierRif    String?
  invoiceNumber  String?
  date           DateTime       @default(now())
  registeredById String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workshop       Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  movements      CashMovement[]

  @@index([workshopId, date])
}

// ==========================================
// Kardex & Stock Auditing Engine
// ==========================================

model InventoryMovement {
  id             String        @id @default(uuid())
  workshopId     String
  itemId         String
  type           String        // IN_PURCHASE, OUT_SALE, OUT_ORDER, ADJUSTMENT_UP, ADJUSTMENT_DOWN, RETURN
  quantity       Float
  previousStock  Float
  newStock       Float
  costPriceUSD   Float?
  workOrderId    String?
  reason         String?
  registeredById String?
  createdAt      DateTime      @default(now())

  workshop       Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([workshopId, itemId])
  @@index([createdAt])
}

// ==========================================
// Mechanic Payroll & Commissions Engine
// ==========================================

model MechanicPayroll {
  id               String    @id @default(uuid())
  workshopId       String
  mechanicId       String
  periodStart      DateTime
  periodEnd        DateTime
  baseSalaryUSD    Float     @default(0)
  commissionRate   Float     @default(0)
  commissionUSD    Float     @default(0)
  bonusesUSD       Float     @default(0)
  deductionsUSD    Float     @default(0)
  totalUSD         Float
  totalVES         Float     @default(0)
  status           String    @default("PENDING") // PENDING, PAID, CANCELLED
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workshop         Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  mechanic         Mechanic  @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([workshopId, mechanicId])
}

// ==========================================
// Security & Compliance Audit Log
// ==========================================

model AuditLog {
  id         String    @id @default(uuid())
  workshopId String?
  userId     String?
  action     String    // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, PAYMENT_REPORT, etc.
  entity     String    // WORK_ORDER, INVENTORY, CLIENT, CASH, USER, etc.
  entityId   String?
  ipAddress  String?
  details    String?
  createdAt  DateTime  @default(now())

  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, createdAt])
}


