# ===============================================
# RUMILCAR SAAS - SUPABASE & SERVER CONFIGURATION
# ===============================================

# Port for local development
PORT=3001

# Supabase PostgreSQL Connection String (Transaction Pooler - Mode: Transaction)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection String (Session / Direct Connection for Migrations)
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT Secret for authenticating users (generate a long random value)
JWT_SECRET="replace-with-a-long-random-secret"

# Password recovery security pepper (different from JWT_SECRET)
PASSWORD_RESET_PEPPER="replace-with-another-long-random-secret"

# Email provider: gmail, relay, brevo or resend
EMAIL_PROVIDER="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-workshop@gmail.com"
SMTP_PASSWORD="your-google-app-password"
MAIL_FROM="Rumilcar App <your-workshop@gmail.com>"
EMAIL_RELAY_URL="https://your-vercel-domain.vercel.app/api/send-email"
EMAIL_RELAY_SECRET="replace-with-relay-secret"
FRONTEND_URL="http://localhost:5173"
PASSWORD_RESET_EXPIRES_MINUTES="15"
PASSWORD_RESET_RATE_LIMIT_SECONDS="60"

# Supabase Public API Credentials (Optional: for storage & public features)
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN="http://localhost:5173,https://*.vercel.app"
